# The prebuilt kernel Image is fetched at build time (~39 MB) -- never commit it.
/prebuilt/Image
/prebuilt/*.img

# Build / packaging outputs
/dist/
/build.log
/out/

# Editor / OS noise
*~
.DS_Store
prebuilt/modules/
recovery/root/lib/modules/*.ko

# Secrets and personal data must never be committed.
.env
.env.*
!.env.example
*.pem
*.key
*.jks
*.keystore
id_rsa*
*.log
screenshots/
